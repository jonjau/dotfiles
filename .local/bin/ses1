#!/usr/bin/env bash
SESSION="heureka"

create_session() {
    local session="$1"
    # Window 1: editor — 4 equal tiles (2x2)
    # pane 1 = yazi (top-left), pane 2 = (top-right), pane 3 = nvim (bottom-left), pane 4 = (bottom-right)
    tmux new-session -d -s "$session" -n editor -x "$(tput cols)" -y "$(tput lines)" -c "$HOME/2-res/dev/box"
    tmux split-window -h -t "$session:1" -c "$HOME/2-res/dev/box/heureka"
    tmux split-window -h -t "$session:1" -c "$HOME/2-res/dev/box/heureka-design"
    tmux split-window -h -t "$session:1" -c "$HOME/2-res/dev/box/heureka"
    tmux send-keys -t "$session:1.0" 'yazi' Enter
    tmux send-keys -t "$session:1.1" 'pi' Enter
    tmux send-keys -t "$session:1.2" 'nvim ./TODO.md' Enter
    tmux send-keys -t "$session:1.3" 'git status' Enter
    tmux select-layout -t "$session:1" tiled
    # Window 2: lazygit
    tmux new-window -t "$session" -n lazygit -c "$HOME/2-res/dev/box/heureka"
    tmux send-keys -t "$session:2" 'lazygit' Enter
    # Land on editor window, nvim pane
    tmux select-window -t "$session:1"
    tmux select-pane -t "$session:1.2"
}
if [ -n "$TMUX" ]; then
    if ! tmux has-session -t "$SESSION" 2>/dev/null; then
        create_session "$SESSION"
    fi
    tmux switch-client -t "$SESSION"
else
    if ! tmux has-session -t "$SESSION" 2>/dev/null; then
        create_session "$SESSION"
    fi
    tmux attach-session -t "$SESSION"
fi
